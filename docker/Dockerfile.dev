# Contexto de build: a raiz deste projeto.
# O fonte chega por bind mount (infra/docker-compose.dev.yml); só as deps entram
# na imagem, protegidas do mount por um volume anônimo em node_modules.
FROM node:24-alpine
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
EXPOSE 5173
# --host: sem isso o vite escuta só em 127.0.0.1 e o mapeamento de porta não alcança.
CMD ["pnpm", "dev", "--host"]
